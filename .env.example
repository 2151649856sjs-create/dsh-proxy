# ===== Qoder + JoyCode 合并网关配置（改完必须重启） =====
# DSH 只配这一个地址：http://127.0.0.1:8320/v1
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8320

# 两个上游反代（本机跑着的那两个）
QODER_BASE=http://127.0.0.1:8790
JOYCODE_BASE=http://127.0.0.1:8318

# 模型名认不出来时默认给谁：qoder / joycode
DEFAULT_UPSTREAM=qoder

# CORS 允许来源：* 或逗号分隔白名单
CORS_ORIGINS=*

# 上游超时毫秒（只管到拿到响应头，长回复/流式不会被掐）
TIMEOUT_MS=300000

# 可选：DSH 端要填 key 的话设一个，网关会校验（留空=不校验）
REQUIRE_CLIENT_KEY=

# 可选：手工指定某个模型走谁，JSON 格式，如 {"GLM-5.3":"joycode"}
MODEL_MAP=

# 控制台请求日志 1=开 0=关
LOG_REQUESTS=1

# ===== 自动降级（主模型失败时按链换模型重试）=====
FAILOVER=1
# 单次尝试的等待上限（毫秒），超时就换下一个
FAILOVER_TIMEOUT_MS=25000
# 降级链：按顺序尝试，建议放免费/稳定模型
FAILOVER_CHAIN=gpt-6-luna,GLM-5.3-agent,GLM-5.3
